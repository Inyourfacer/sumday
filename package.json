{
  "name": "sumday",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite build && tsx src/server/main.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "oxlint": "^1.92.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
