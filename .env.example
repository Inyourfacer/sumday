# Copy to .env and edit. All settings are optional.

# Where the SQLite database lives (default: var/sumday.db).
# SUMDAY_DB=var/sumday.db

# Where daily backups go (default: var/backups). The newest 30 are kept.
# SUMDAY_BACKUP_DIR=var/backups

# Port for the local web app (default: 4321). It only listens on 127.0.0.1.
# SUMDAY_PORT=4321

# Tiingo API key for daily prices (Phase 4). Free at tiingo.com.
# TIINGO_API_KEY=
